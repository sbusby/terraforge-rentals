{
  "devDependencies": {
    "wrangler": "^4"
  },
  "scripts": {
    "build": "node scripts/build-site.mjs",
    "dev": "npm run build && wrangler d1 migrations apply terraforge-reservations --local && wrangler pages dev",
    "test": "node --test test/",
    "db:migrate": "wrangler d1 migrations apply terraforge-reservations --remote",
    "deploy": "npm run build && wrangler pages deploy",
    "test:e2e": "node scripts/e2e.mjs",
    "setup:cloudflare": "bash scripts/setup-cloudflare.sh"
  },
  "name": "terraforge-rentals",
  "private": true,
  "type": "module",
  "allowScripts": {
    "workerd@1.20261110.1": true,
    "esbuild@0.28.2": true
  }
}
